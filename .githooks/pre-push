#!/usr/bin/env bash

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

cd "$repo_root"

echo "Rendering notebooks before push"
RENDER_NOTEBOOKS_STRICT=1 bash scripts/render_interactive_notebook.sh

git add -A -- ':(glob)**/notebooks/*.md' ':(glob)**/notebooks/figs/**'

if ! git diff --cached --quiet -- ':(glob)**/notebooks/*.md' ':(glob)**/notebooks/figs/**'; then
  echo "Committing rendered notebook artifacts"
  git commit -m "Render notebooks"
fi
